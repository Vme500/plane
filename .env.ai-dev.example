# AI Dev Stack Environment Variables
# Copy to .env.ai-dev.local and fill in real values
# DO NOT commit .env.ai-dev.local

# URLs (required for auth redirects)
APP_BASE_URL=http://localhost:18181
WEB_URL=http://localhost:18180
ADMIN_BASE_URL=http://localhost:18181
SPACE_BASE_URL=http://localhost:18181

# CSRF/CORS (required for cross-origin auth)
CSRF_TRUSTED_ORIGINS=http://localhost:18181
CORS_ALLOWED_ORIGINS=http://localhost:18181

# Database
POSTGRES_USER=plane_ai_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=plane_ai_dev
PGDATA=/var/lib/postgresql/data

# Redis
REDIS_HOST=plane-ai-dev-redis
REDIS_PORT=6379

# RabbitMQ (optional, for worker)
RABBITMQ_HOST=plane-ai-dev-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane_ai_dev
RABBITMQ_PASSWORD=change-me-local-only
RABBITMQ_VHOST=plane_ai_dev

# Django
SECRET_KEY=change-me-to-random-string-local-only
DEBUG=1
ALLOWED_HOSTS=*

# AI Feature Flags
ENABLE_AI_ASSISTANT=1
ENABLE_AI_MCP_RUNTIME=1
AI_MCP_ADAPTER=mock

# LLM Configuration
# Replace with your real API key in .env.ai-dev.local
LLM_API_KEY=replace-me
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# AWS / MinIO (optional, for file uploads)
AWS_REGION=
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT_URL=http://plane-ai-dev-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# Worker
# Use rabbitmq:// or redis:// depending on your setup
CELERY_BROKER_URL=redis://plane-ai-dev-redis:6379/0
